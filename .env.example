# Yahoo!ショッピング Client ID。サーバーだけで使用。EXPO_PUBLICには設定しない。
YAHOO_SHOPPING_APP_ID=
# アプリから呼ぶ検索API（ネイティブはHTTPSの完全URL。Web同一サイトは /api/yahoo-product）。
EXPO_PUBLIC_YAHOO_LOOKUP_URL=

# Shared product API base URL (HTTPS in production; never put database credentials here)
EXPO_PUBLIC_SHARED_PRODUCTS_URL=

# Public contact information. Use an HTTPS policy page; restart Expo after editing.
EXPO_PUBLIC_OPERATOR_NAME=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_PRIVACY_POLICY_URL=

# Development demo only. Leave false for public builds and ordinary first launch.
EXPO_PUBLIC_DEMO_DATA=false
