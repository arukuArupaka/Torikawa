{
  "expo": {
    "name": "たべどき！！",
    "slug": "refrigerator-note",
    "version": "1.20.0",
    "orientation": "portrait",
    "icon": "./assets/branding/fresh-moment.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.arukuarupaka.tabedoki",
      "buildNumber": "1"
    },
    "android": {
      "icon": "./assets/branding/fresh-moment.png",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/branding/fresh-moment.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "食材写真を選ぶため、写真ライブラリへのアクセスを使用します。",
          "cameraPermission": "食材写真を撮影するため、カメラを使用します。",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "商品バーコードを読み取るため、カメラを使用します。",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "f5c33856-c308-4c95-913e-c7541999bfc3"
      }
    },
    "owner": "maeken"
  }
}
