{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "distribution": "store",
      "environment": "production",
      "node": "24.21.0",
      "env": {
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_OPERATOR_NAME": "たべどき!!運営",
        "EXPO_PUBLIC_SUPPORT_FORM_URL": "https://forms.gle/Rjoy4xiwzE7uBDf57",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://tabedoki-official.pages.dev/privacy.html",
        "EXPO_PUBLIC_YAHOO_LOOKUP_URL": "https://tabedoki-yahoo-lookup.yahoo-lookup.workers.dev/api/yahoo-product",
        "EXPO_PUBLIC_SHARED_PRODUCTS_URL": "",
        "EXPO_PUBLIC_DEMO_DATA": "false",
        "EXPO_PUBLIC_WEB_TEST": "false"
      },
      "ios": {
        "simulator": false,
        "autoIncrement": true
      }
    }
  }
}
